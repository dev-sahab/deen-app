<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Auto-silent -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- DNS content filter -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Lets getInstalledApps() list launchable apps without QUERY_ALL_PACKAGES -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <receiver
      android:name="expo.modules.deenguard.SilentReceiver"
      android:exported="false" />

    <receiver
      android:name="expo.modules.deenguard.BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>

    <service
      android:name="expo.modules.deenguard.DnsVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <meta-data
        android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
        android:value="true" />
    </service>

    <service
      android:name="expo.modules.deenguard.AppBlockerService"
      android:exported="false"
      android:label="@string/deen_guard_app_blocker_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/deen_guard_app_blocker" />
    </service>
  </application>
</manifest>
