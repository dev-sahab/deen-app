{
  "name": "deen-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "^58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "adhan": "^4.4.6",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "^58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linking": "^58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "start": "node init && expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "node init && eas build --profile development --platform android",
    "build:apk": "node init && eas build --profile preview --platform android",
    "build:prod": "node init && eas build --profile production --platform android",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?/.*|expo-.*|adhan|zustand))"
    ],
    "globalSetup": "./jest.global-setup.js"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1"
  }
}
